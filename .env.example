# AI Drama Studio environment configuration

# Public, browser-visible AI settings. Do not put server secrets in VITE_* values.
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
VITE_SEEDANCE_API_KEY=your_seedance_api_key_here
VITE_RUNWAY_API_KEY=your_runway_api_key_here
VITE_PIKA_API_KEY=your_pika_api_key_here
VITE_CUSTOM_API_KEY=your_custom_api_key_here
VITE_CUSTOM_API_URL=https://api.example.com/v1

# Node/Express application server
PORT=8787
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development

# Optional path for a persistent production volume. The database file is DATA_DIR/database.json.
# DATA_DIR=/var/data

# SMTP email verification. Use a provider-issued app password, never the mailbox login password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_app_password
SMTP_FROM="AI Drama Studio <no-reply@example.com>"

# Netlify's same-origin backend proxy. Set this only in the Netlify environment variables UI.
# API_ORIGIN=https://your-node-backend.example.com
