# AI Drama Studio environment configuration

# Never place API keys in VITE_* variables. Vite embeds them in public browser bundles.

# Node/Express application server
PORT=8787
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development

# Production cloud database. Railway should reference MySQL.MYSQL_URL; do not expose it to the browser.
# DATABASE_URL=mysql://user:password@host:3306/database
# Set true for managed cloud MySQL endpoints that require TLS; certificate validation stays enabled.
DATABASE_SSL=true

# Optional path for a persistent production volume. The database file is DATA_DIR/database.json.
# DATA_DIR=/var/data

# Optional Cloudflare R2 image storage. When all four values are set, new image bytes are stored in R2
# and MySQL keeps metadata only. Create a bucket-scoped Object Read & Write API token.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=ai-drama-assets
# Per-user cloud image quota in bytes. Default: 2147483648 (2 GiB).
ASSET_USER_QUOTA_BYTES=2147483648
# Unreferenced assets are permanently deleted after this many days. Default: 30.
ASSET_RETENTION_DAYS=30
GENERATED_VIDEO_MAX_BYTES=1073741824

# Independent key used to encrypt database backup files (minimum 24 characters).
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
# Railway Cron can invoke a separate maintenance service, or the app runs this interval itself.
MAINTENANCE_INTERVAL_HOURS=6

# Production payments. PAYMENT_NOTIFY_BASE_URL must be the public Railway HTTPS origin.
PAYMENT_NOTIFY_BASE_URL=https://your-railway-service.example
# Alipay computer website payment (RSA2).
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_RETURN_URL=https://your-frontend.example/payment-return
# WeChat Pay H5 (API v3). API v3 key must be exactly 32 bytes.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_API_V3_KEY=

# External monitoring. Use Better Stack/UptimeRobot for GET /api/health and optionally set a HTTPS webhook.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
MONITORING_INTERVAL_MINUTES=5
ALERT_QUEUE_BACKLOG=25
ALERT_FAILURE_RATE=0.2

# Persistent managed-video queue. Keep Railway at one application replica with this database-backed scheduler.
VIDEO_QUEUE_GLOBAL_CONCURRENCY=12
VIDEO_QUEUE_USER_CONCURRENCY=4
VIDEO_QUEUE_API_CONCURRENCY=8
VIDEO_QUEUE_POLL_CONCURRENCY=12
VIDEO_QUEUE_MAX_PENDING_PER_USER=50
VIDEO_QUEUE_TASK_TIMEOUT_MINUTES=60
VIDEO_QUEUE_HISTORY_DAYS=7
VIDEO_QUEUE_LEASE_SECONDS=120

# Protection for text/image/system/custom AI calls (video has its own queue above).
AI_REQUEST_GLOBAL_CONCURRENCY=16
AI_REQUEST_USER_CONCURRENCY=4
AI_REQUESTS_PER_MINUTE=60
AI_MAX_RESPONSE_BYTES=8388608
AI_UPSTREAM_TIMEOUT_MS=90000

# Recommended on Railway Trial/Hobby: HTTPS transactional email via Resend.
# EMAIL_FROM must use a sender/domain verified in your Resend account.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="AI Drama Studio <register@your-verified-domain.example>"

# Optional SMTP fallback when RESEND_API_KEY is not set. Railway requires Pro for SMTP.
# Use a provider-issued app password, never the mailbox login password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_app_password
SMTP_FROM="AI Drama Studio <no-reply@example.com>"

# Netlify's same-origin backend proxy. Set this only in the Netlify environment variables UI.
# API_ORIGIN=https://your-node-backend.example.com
