{
  "name": "ai-drama-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI短剧生成工作台 - 无限画布",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host",
    "dev:server": "node --watch server/index.js",
    "dev:local": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "start": "node server/entry.js",
    "test": "node --test server/test/*.test.js",
    "backup:drill": "node server/scripts/backup-drill.js",
    "backup:mysql-drill": "node server/scripts/mysql-restore-drill.js",
    "maintenance:once": "node server/scripts/maintenance.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@xyflow/react": "^12.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg-captcha": "^1.4.0",
    "word-extractor": "^1.0.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.4",
    "jszip": "^3.10.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^6.4.3"
  }
}
